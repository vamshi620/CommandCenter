@inherits LayoutComponentBase

<nav class="cc-topnav">
    <NavLink class="cc-topnav__link" href="/" Match="NavLinkMatch.All">
        <span>📊</span> Overview
    </NavLink>
    <NavLink class="cc-topnav__link" href="/projects">
        <span>📁</span> Projects
    </NavLink>
    <NavLink class="cc-topnav__link" href="/team">
        <span>👥</span> Team
    </NavLink>
    <NavLink class="cc-topnav__link" href="/daily">
        <span>📅</span> Daily Log
    </NavLink>
    <div style="flex:1"></div>
    <button class="btn-icon" @onclick="ToggleTheme" style="font-size:1.2rem;margin-right:1rem" title="Toggle Light/Dark Mode">🌓</button>
</nav>

<div class="cc-layout">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private async Task ToggleTheme()
    {
        await JSRuntime.InvokeVoidAsync("toggleTheme");
    }
}
