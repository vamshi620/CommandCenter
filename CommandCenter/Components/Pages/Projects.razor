@page "/projects"
@using CommandCenter.Application.Interfaces
@using CommandCenter.Domain.Enums
@using CommandCenter.Domain.Models
@inject ICommandCenterService Service
@rendermode InteractiveServer

<PageTitle>Command Center — Projects</PageTitle>

<header class="cc-header">
    <div class="cc-header__brand">
        <span class="cc-header__icon">📁</span>
        <div>
            <h1 class="cc-header__title">Projects</h1>
            <p class="cc-header__subtitle">@_projects.Count project(s) tracked</p>
        </div>
    </div>
    <button class="btn-rollover" @onclick="() => _showAddProject = !_showAddProject">＋ New Project</button>
</header>

@* ── Add Project Panel ─────────────────────────────────────────────────── *@
@if (_showAddProject)
{
    <div class="proj-add-panel">
        <h3 class="proj-add-panel__title">New Project</h3>
        <div class="cc-form">
            <input class="cc-input" placeholder="Project name *" @bind="_newProject.Name" />
            <input class="cc-input" placeholder="Description" @bind="_newProject.Description" />
            <div class="cc-form-row">
                <select class="cc-select" @bind="_newProject.Status">
                    @foreach (var s in Enum.GetValues<ProjectStatus>()) { <option value="@s">@s</option> }
                </select>
                <select class="cc-select" @bind="_newProject.Priority">
                    @foreach (var p in Enum.GetValues<ProjectPriority>()) { <option value="@p">@p</option> }
                </select>
                <input class="cc-input" type="date" @bind="_newProject.TargetDate" />
            </div>
            <div style="display:flex;gap:.5rem">
                <button class="btn-add" @onclick="AddProject">Create</button>
                <button class="btn-cancel" @onclick="() => _showAddProject = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_projects.Count == 0)
{
    <div class="proj-empty">
        <p>📭 No projects yet. Click <strong>New Project</strong> to get started.</p>
    </div>
}

@* ── Project Selector Tabs ─────────────────────────────────────────────── *@
@if (_projects.Count > 0)
{
    <div class="proj-selector">
        @foreach (var p in _projects)
        {
            var isActive = _selectedProjectId == p.Id;
            var riskClass = p.Status == ProjectStatus.AtRisk ? "sel--risk"
                          : p.Status == ProjectStatus.Delayed ? "sel--delayed"
                          : p.Status == ProjectStatus.Completed ? "sel--done" : "";
            <button class="proj-sel-btn @(isActive ? "proj-sel-btn--active" : "") @riskClass"
                    @onclick="() => SelectProject(p.Id)">
                <span class="proj-priority-dot @PriorityDotClass(p.Priority)"></span>
                @p.Name
                <span class="proj-sel-badge">@p.WorkItems.Count</span>
            </button>
        }
    </div>
}

@* ── Selected Project Detail ───────────────────────────────────────────── *@
@if (_selected is not null)
{
    var total  = _selected.WorkItems.Count;
    var done   = _selected.WorkItems.Count(wi => wi.Status == WorkItemStatus.Completed);
    var pct    = total == 0 ? 0 : (int)(done * 100.0 / total);
    var overdue = _selected.TargetDate.HasValue && _selected.TargetDate.Value.Date < DateTime.UtcNow.Date && _selected.Status != ProjectStatus.Completed;

    <div class="proj-detail-header">
        @* Left column: name, status, meta *@
        <div class="proj-detail-left">
            <div class="proj-detail-title-row">
                <h2 class="proj-detail-name">@_selected.Name</h2>
                <span class="cc-badge @ProjectStatusBadge(_selected.Status)">@_selected.Status</span>
                <select class="cc-select" style="width:140px" @onchange="e => UpdateStatus(e)">
                    @foreach (var s in Enum.GetValues<ProjectStatus>())
                    {
                        <option value="@s" selected="@(_selected.Status == s)">@s</option>
                    }
                </select>
                <button class="btn-delete" @onclick="() => DeleteProject(_selected.Id)" title="Delete project">🗑</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_selected.Description))
            {
                <p class="proj-detail-desc">@_selected.Description</p>
            }
            <div class="proj-detail-meta">
                @if (_selected.TargetDate.HasValue)
                {
                    <span class="@(overdue ? "text-red" : "text-muted")">
                        🎯 @_selected.TargetDate.Value.ToString("MMM d, yyyy")@(overdue ? " ⚠️ Overdue" : "")
                    </span>
                }
                <span class="text-muted">📅 Created @_selected.CreatedDate.ToLocalTime().ToString("MMM d, yyyy")</span>
            </div>
        </div>

        @* Right column: progress + team *@
        <div class="proj-detail-right">
            <div class="proj-progress-wrap">
                <div class="proj-progress-label">
                    <span>Progress</span>
                    <span class="proj-progress-pct">@pct%</span>
                </div>
                <div class="progress-bar progress-bar--lg">
                    <div class="progress-bar__fill @ProgressClass(pct)" style="width:@pct%"></div>
                </div>
                <div class="proj-progress-sub">@done of @total items completed</div>
            </div>

            <div class="proj-team-row">
                @foreach (var pm in _selected.Members)
                {
                    <span class="avatar-sm avatar-color-@(pm.TeamMember?.AvatarColorIndex ?? 0)"
                          title="@pm.TeamMember?.Name (@pm.ProjectRole)">
                        @(pm.TeamMember?.Name?.Substring(0, 1).ToUpper() ?? "?")
                    </span>
                }
                @foreach (var pm in _selected.Members)
                {
                    <button class="btn-icon btn-icon--danger" style="font-size:.65rem;padding:2px 6px"
                            @onclick="() => RemoveMember(pm.Id)" title="Remove @pm.TeamMember?.Name">
                        ✕ @pm.TeamMember?.Name
                    </button>
                }
            </div>

            @* Add team member *@
            <div class="proj-team-row" style="flex-wrap:wrap">
                <select class="cc-select" style="width:150px;font-size:.75rem" @bind="_addMemberId">
                    <option value="0">＋ Add member…</option>
                    @foreach (var m in _availableToAdd)
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
                @if (_addMemberId > 0)
                {
                    <select class="cc-select" style="width:110px;font-size:.75rem" @bind="_addMemberRole">
                        <option>Member</option><option>Lead</option><option>Stakeholder</option><option>Observer</option>
                    </select>
                    <button class="btn-add" style="padding:4px 12px;font-size:.75rem" @onclick="AddMemberToProject">Add</button>
                }
            </div>
        </div>
    </div>

    @* Summary chips *@
    <div class="proj-summary-bar">
        @{ var oi = _selected.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Issue       && wi.Status != WorkItemStatus.Completed);
           var od = _selected.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Delay       && wi.Status != WorkItemStatus.Completed);
           var op = _selected.WorkItems.Count(wi => wi.ItemType == ProjectItemType.PendingItem && wi.Status == WorkItemStatus.Pending);
           var or_ = _selected.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Risk       && wi.Status != WorkItemStatus.Completed); }
        <span class="proj-chip proj-chip--red">🔴 @oi Issues</span>
        <span class="proj-chip proj-chip--amber">⚠️ @od Delays</span>
        <span class="proj-chip proj-chip--blue">🕐 @op Pending</span>
        <span class="proj-chip proj-chip--purple">⚡ @or_ Risks</span>
    </div>

    @* ── Project Notes ─────────────────────────────────────────────────────── *@
    <div style="padding: 1rem 2rem; border-bottom: 1px solid var(--cc-border); background: var(--cc-surface-2);">
        <textarea class="cc-input" style="width: 100%; min-height: 80px; resize: vertical; font-size: 0.8125rem;" 
                  placeholder="Add notes or thoughts for this project... (Saves automatically on blur)" 
                  @onchange="UpdateNotes" value="@_selected.Notes"></textarea>
    </div>

    @* ── Kanban Board ──────────────────────────────────────────────────────── *@
    <div class="kanban-board">
        @foreach (var col in _kanbanColumns)
        {
            var colItems = _selected.WorkItems
                .Where(wi => wi.Status == col.Status && (_typeFilter == null || wi.ItemType == _typeFilter))
                .OrderByDescending(wi => wi.Priority)
                .ThenBy(wi => wi.DueDate)
                .ToList();
            var colIdx = Array.IndexOf(_kanbanColumns, col);

            <div class="kanban-col">
                <div class="kanban-col__header @col.HeaderClass">
                    <span class="kanban-col__icon">@col.Icon</span>
                    <span class="kanban-col__title">@col.Label</span>
                    <span class="kanban-col__count">@colItems.Count</span>
                </div>
                <div class="kanban-col__body">
                    @if (!colItems.Any())
                    {
                        <div class="kanban-empty">Drop items here</div>
                    }
                    @foreach (var wi in colItems)
                    {
                        var wiOverdue = wi.DueDate.HasValue && wi.DueDate.Value.Date < DateTime.UtcNow.Date;
                        <div class="kanban-card @KanbanCardClass(wi)">
                            <div class="kanban-card__top">
                                <span class="kanban-type-icon">@ItemTypeIcon(wi.ItemType)</span>
                                <span class="kanban-card__title">@wi.Title</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(wi.Description))
                            {
                                <p class="kanban-card__desc">@wi.Description</p>
                            }
                            <div class="kanban-card__meta">
                                <span class="cc-badge @PriorityBadge(wi.Priority)">@wi.Priority</span>
                                @if (wi.DueDate.HasValue)
                                {
                                    <span class="@(wiOverdue ? "text-red" : "text-muted")">
                                        📅 @wi.DueDate.Value.ToString("MMM d")@(wiOverdue ? " ⚠️" : "")
                                    </span>
                                }
                            </div>
                            <div class="kanban-card__footer">
                                @if (wi.AssignedTeamMember is not null)
                                {
                                    <span class="avatar-xs avatar-color-@wi.AssignedTeamMember.AvatarColorIndex"
                                          title="@wi.AssignedTeamMember.Name">
                                        @wi.AssignedTeamMember.Name.Substring(0, 1).ToUpper()
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(wi.AssignedTo))
                                {
                                    <span class="kanban-assignee">👤 @wi.AssignedTo</span>
                                }
                                else
                                {
                                    <span class="kanban-unassigned">Unassigned</span>
                                }
                                <div class="kanban-move-btns">
                                    @if (colIdx > 0)
                                    {
                                        <button class="kanban-move kanban-move--left" @onclick="() => MoveLeft(wi)" title="Move back">‹</button>
                                    }
                                    @if (colIdx < _kanbanColumns.Length - 1)
                                    {
                                        <button class="kanban-move kanban-move--right" @onclick="() => MoveRight(wi)" title="Move forward">›</button>
                                    }
                                    <button class="btn-icon" style="padding:2px 6px;font-size:.8rem" @onclick="() => OpenWorkItemDetail(wi.Id)" title="Edit">✏️</button>
                                    <button class="btn-delete" style="padding:2px 6px;font-size:.7rem" @onclick="() => DeleteWorkItem(wi.Id)">🗑</button>
                                </div>
                            </div>
                            @if (_selected.Members.Any())
                            {
                                <select class="cc-select kanban-assign-select" @onchange="e => QuickAssign(wi.Id, e)">
                                    <option value="0">Assign to…</option>
                                    @foreach (var pm in _selected.Members)
                                    {
                                        <option value="@pm.TeamMemberId" selected="@(wi.AssignedTeamMemberId == pm.TeamMemberId)">
                                            @pm.TeamMember?.Name (@pm.ProjectRole)
                                        </option>
                                    }
                                </select>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* ── Add Work Item Bar ─────────────────────────────────────────────────── *@
    <div class="kanban-add-bar">
        <div class="kanban-add-form">
            <input class="cc-input kanban-add-input" placeholder="Work item title *" @bind="_newItem.Title" />
            <input class="cc-input kanban-add-input" placeholder="Description (optional)" @bind="_newItem.Description" />
            <select class="cc-select kanban-add-select" @bind="_newItem.ItemType">
                @foreach (var t in Enum.GetValues<ProjectItemType>())
                { <option value="@t">@ItemTypeIcon(t) @t</option> }
            </select>
            <select class="cc-select kanban-add-select" @bind="_newItem.Priority">
                @foreach (var p in Enum.GetValues<ProjectPriority>())
                { <option value="@p">@p</option> }
            </select>
            <input class="cc-input kanban-add-date" type="date" @bind="_newItem.DueDate" />
            <select class="cc-select kanban-add-select" @bind="_newItem.AssignedTeamMemberId">
                <option value="">Unassigned</option>
                @foreach (var pm in _selected.Members)
                { <option value="@pm.TeamMemberId">@pm.TeamMember?.Name</option> }
            </select>
            <button class="btn-add" @onclick="AddWorkItem">＋ Add</button>
        </div>
        <div class="kanban-filter">
            <span class="filter-label">Filter:</span>
            <button class="proj-tab @(_typeFilter == null ? "proj-tab--active" : "")" @onclick="() => _typeFilter = null">All</button>
            @foreach (var t in Enum.GetValues<ProjectItemType>())
            {
                <button class="proj-tab @(_typeFilter == t ? "proj-tab--active" : "")" @onclick="() => _typeFilter = t">
                    @ItemTypeIcon(t) @t
                </button>
            }
        </div>
    </div>
}

@* ── Work Item Detail / Edit Panel ─────────────────────────────────────── *@
@if (_editingWorkItem is not null)
{
    <div class="modal-overlay" @onclick="CloseWorkItemDetail">
        <div class="modal-content" style="max-width: 600px" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Edit Work Item</h3>
                <button class="btn-icon" @onclick="CloseWorkItemDetail">✕</button>
            </div>
            <div class="modal-body cc-form">
                <input class="cc-input" placeholder="Title *" @bind="_editingWorkItem.Title" />
                <textarea class="cc-input" placeholder="Description" style="min-height: 80px" @bind="_editingWorkItem.Description"></textarea>
                
                <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                    <select class="cc-select" style="flex: 1" @bind="_editingWorkItem.ItemType">
                        @foreach (var t in Enum.GetValues<ProjectItemType>()) { <option value="@t">@t</option> }
                    </select>
                    <select class="cc-select" style="flex: 1" @bind="_editingWorkItem.Priority">
                        @foreach (var p in Enum.GetValues<ProjectPriority>()) { <option value="@p">@p</option> }
                    </select>
                    <input class="cc-input" type="date" style="flex: 1" @bind="_editingWorkItem.DueDate" />
                </div>
                
                <div style="display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem">
                    <label style="color: var(--cc-text-muted); font-size: 0.85rem; width: 80px;">Assignee:</label>
                    <select class="cc-select" style="flex: 1" @bind="_editingWorkItem.AssignedTeamMemberId">
                        <option value="">Unassigned</option>
                        @foreach (var pm in _selected?.Members ?? [])
                        { <option value="@pm.TeamMemberId">@pm.TeamMember?.Name</option> }
                    </select>
                </div>
                
                <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem">
                    <button class="btn-add" @onclick="SaveWorkItemDetail">Save Changes</button>
                    <button class="btn-cancel" @onclick="CloseWorkItemDetail">Cancel</button>
                </div>
                
                <hr style="border: 0; border-top: 1px solid var(--cc-border); margin: 2rem 0 1rem 0;" />
                
                <h4>Comments (@_editingWorkItem.Comments.Count)</h4>
                <div class="comments-list" style="max-height: 200px; overflow-y: auto; margin-bottom: 1rem; padding-right: 0.5rem;">
                    @if (!_editingWorkItem.Comments.Any())
                    {
                        <div class="cc-empty" style="padding: 1rem">No comments yet.</div>
                    }
                    @foreach (var c in _editingWorkItem.Comments.OrderBy(x => x.CreatedDate))
                    {
                        <div style="background: var(--cc-surface-2); padding: 0.75rem; border-radius: var(--radius-sm); margin-bottom: 0.5rem;">
                            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--cc-text-muted); margin-bottom: 0.25rem;">
                                <strong>@c.Author</strong>
                                <span>@c.CreatedDate.ToLocalTime().ToString("MMM d, HH:mm")</span>
                            </div>
                            <div style="font-size: 0.85rem; white-space: pre-wrap;">@c.Content</div>
                        </div>
                    }
                </div>
                
                <div style="display: flex; gap: 0.5rem">
                    <input class="cc-input" style="flex: 1" placeholder="Add a comment..." @bind="_newCommentContent" @bind:event="oninput" @onkeyup="@(e => { if(e.Key == "Enter") AddComment(); })" />
                    <button class="btn-rollover" @onclick="AddComment">Send</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Project>    _projects   = [];
    private List<TeamMember> _allMembers = [];
    private int              _selectedProjectId;
    private Project?         _selected;
    private ProjectItemType? _typeFilter;

    private bool    _showAddProject = false;
    private Project _newProject     = new();
    private ProjectWorkItem _newItem = new();
    private int    _addMemberId   = 0;
    private string _addMemberRole = "Member";
    
    private ProjectWorkItem? _editingWorkItem;
    private string _newCommentContent = "";

    private IEnumerable<TeamMember> _availableToAdd =>
        _allMembers.Where(m => _selected?.Members.All(pm => pm.TeamMemberId != m.Id) ?? true);

    private record KanbanCol(string Label, WorkItemStatus Status, string Icon, string HeaderClass);
    private readonly KanbanCol[] _kanbanColumns =
    [
        new("To Do",       WorkItemStatus.Pending,    "📋", "kcol--grey"),
        new("In Progress", WorkItemStatus.InProgress, "🔄", "kcol--blue"),
        new("Blocked",     WorkItemStatus.Blocked,    "🚫", "kcol--red"),
        new("Done",        WorkItemStatus.Completed,  "✅", "kcol--green"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Load();
        if (_projects.Count > 0 && _selectedProjectId == 0)
            SelectProject(_projects[0].Id);
    }

    private async Task Load()
    {
        _projects   = (await Service.GetProjectsAsync()).ToList();
        _allMembers = (await Service.GetTeamMembersAsync()).ToList();
        if (_selectedProjectId > 0)
            _selected = _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
    }

    private void SelectProject(int id)
    {
        _selectedProjectId = id;
        _selected = _projects.FirstOrDefault(p => p.Id == id);
        _newItem  = new ProjectWorkItem { ProjectId = id };
        _addMemberId = 0;
    }

    private async Task AddProject()
    {
        if (string.IsNullOrWhiteSpace(_newProject.Name)) return;
        var created = await Service.AddProjectAsync(_newProject);
        _newProject = new(); _showAddProject = false;
        await Load();
        SelectProject(created.Id);
    }

    private async Task UpdateStatus(ChangeEventArgs e)
    {
        if (_selected is null) return;
        if (Enum.TryParse<ProjectStatus>(e.Value?.ToString(), out var s))
            await Service.UpdateProjectStatusAsync(_selected.Id, s);
        await Load(); SelectProject(_selected.Id);
    }

    private async Task UpdateNotes(ChangeEventArgs e)
    {
        if (_selected is null) return;
        var notes = e.Value?.ToString();
        await Service.UpdateProjectNotesAsync(_selected.Id, notes);
        await Load(); SelectProject(_selected.Id);
    }

    private async Task DeleteProject(int id)
    {
        await Service.DeleteProjectAsync(id);
        _selectedProjectId = 0; _selected = null;
        await Load();
        if (_projects.Count > 0) SelectProject(_projects[0].Id);
    }

    private async Task AddMemberToProject()
    {
        if (_selected is null || _addMemberId == 0) return;
        await Service.AddProjectMemberAsync(_selected.Id, _addMemberId, _addMemberRole);
        _addMemberId = 0;
        await Load(); SelectProject(_selected.Id);
    }

    private async Task RemoveMember(int pmId)
    {
        await Service.RemoveProjectMemberAsync(pmId);
        await Load(); if (_selected != null) SelectProject(_selected.Id);
    }

    private async Task AddWorkItem()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_newItem.Title)) return;
        _newItem.ProjectId = _selected.Id;
        await Service.AddProjectWorkItemAsync(_newItem);
        _newItem = new ProjectWorkItem { ProjectId = _selected.Id };
        await Load(); SelectProject(_selected.Id);
    }

    private async Task QuickAssign(int wiId, ChangeEventArgs e)
    {
        int? memberId = int.TryParse(e.Value?.ToString(), out var mid) && mid > 0 ? mid : null;
        var wi = _selected?.WorkItems.FirstOrDefault(x => x.Id == wiId);
        if (wi is null) return;
        await Service.UpdateProjectWorkItemAsync(wiId, wi.Status, memberId);
        await Load(); if (_selected != null) SelectProject(_selected.Id);
    }

    private async Task MoveLeft(ProjectWorkItem wi)
    {
        var colIdx = Array.FindIndex(_kanbanColumns, c => c.Status == wi.Status);
        if (colIdx <= 0) return;
        await Service.UpdateProjectWorkItemAsync(wi.Id, _kanbanColumns[colIdx - 1].Status, wi.AssignedTeamMemberId);
        await Load(); if (_selected != null) SelectProject(_selected.Id);
    }

    private async Task MoveRight(ProjectWorkItem wi)
    {
        var colIdx = Array.FindIndex(_kanbanColumns, c => c.Status == wi.Status);
        if (colIdx >= _kanbanColumns.Length - 1) return;
        await Service.UpdateProjectWorkItemAsync(wi.Id, _kanbanColumns[colIdx + 1].Status, wi.AssignedTeamMemberId);
        await Load(); if (_selected != null) SelectProject(_selected.Id);
    }

    private async Task DeleteWorkItem(int id)
    {
        await Service.DeleteProjectWorkItemAsync(id);
        await Load(); if (_selected != null) SelectProject(_selected.Id);
    }

    private async Task OpenWorkItemDetail(int wiId)
    {
        _editingWorkItem = await Service.GetProjectWorkItemDetailAsync(wiId);
        _newCommentContent = "";
    }

    private void CloseWorkItemDetail()
    {
        _editingWorkItem = null;
    }

    private async Task SaveWorkItemDetail()
    {
        if (_editingWorkItem != null)
        {
            await Service.UpdateProjectWorkItemDetailsAsync(_editingWorkItem);
            _editingWorkItem = null;
            await Load();
            if (_selected != null) SelectProject(_selected.Id);
        }
    }

    private async Task AddComment()
    {
        if (_editingWorkItem != null && !string.IsNullOrWhiteSpace(_newCommentContent))
        {
            var authorName = await Service.GetAppSettingAsync("PmName", "Project Manager");
            if (string.IsNullOrWhiteSpace(authorName)) authorName = "Project Manager";

            await Service.AddWorkItemCommentAsync(new WorkItemComment 
            { 
                WorkItemId = _editingWorkItem.Id, 
                Content = _newCommentContent,
                Author = authorName
            });
            _newCommentContent = "";
            _editingWorkItem = await Service.GetProjectWorkItemDetailAsync(_editingWorkItem.Id);
        }
    }

    private static string ProjectStatusBadge(ProjectStatus s) => s switch
    { ProjectStatus.Active => "badge--blue", ProjectStatus.AtRisk => "badge--red",
      ProjectStatus.Delayed => "badge--red", ProjectStatus.Completed => "badge--green",
      ProjectStatus.Planning => "badge--yellow", _ => "badge--grey" };

    private static string PriorityDotClass(ProjectPriority p) => p switch
    { ProjectPriority.Critical => "dot--red", ProjectPriority.High => "dot--amber",
      ProjectPriority.Medium => "dot--blue", _ => "dot--grey" };

    private static string PriorityBadge(ProjectPriority p) => p switch
    { ProjectPriority.Critical => "badge--red", ProjectPriority.High => "badge--red",
      ProjectPriority.Medium => "badge--yellow", _ => "badge--grey" };

    private static string ProgressClass(int pct) =>
        pct >= 80 ? "fill--green" : pct >= 40 ? "fill--blue" : "fill--amber";

    private static string KanbanCardClass(ProjectWorkItem wi)
    {
        if (wi.Status == WorkItemStatus.Completed) return "kanban-card--done";
        if (wi.DueDate.HasValue && wi.DueDate.Value.Date < DateTime.UtcNow.Date) return "kanban-card--overdue";
        return wi.ItemType switch
        { ProjectItemType.Issue => "kanban-card--issue", ProjectItemType.Delay => "kanban-card--delay",
          ProjectItemType.Risk => "kanban-card--risk", _ => "" };
    }

    private static string ItemTypeIcon(ProjectItemType t) => t switch
    { ProjectItemType.Issue => "🔴", ProjectItemType.Delay => "⚠️",
      ProjectItemType.PendingItem => "🕐", ProjectItemType.Risk => "⚡",
      ProjectItemType.Milestone => "🎯", _ => "📌" };
}
