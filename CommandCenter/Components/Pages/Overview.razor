@page "/"
@using CommandCenter.Application.Interfaces
@using CommandCenter.Domain.Enums
@using CommandCenter.Domain.Models
@inject ICommandCenterService Service
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Command Center — PM Overview</PageTitle>

<header class="cc-header">
    <div class="cc-header__brand">
        <span class="cc-header__icon">📊</span>
        <div>
            <h1 class="cc-header__title">PM Dashboard</h1>
            <p class="cc-header__subtitle">@DateTime.Now.ToString("dddd, MMMM d yyyy  •  HH:mm")</p>
        </div>
    </div>
    <div style="display:flex;align-items:center">
        <button class="btn-rollover" @onclick="ExportCsv" style="background:var(--cc-surface-2);color:var(--cc-text)">📥 Export CSV</button>
    </div>
</header>

@if (_projects.Count == 0 && _teamMembers.Count == 0)
{
    <div class="overview-welcome">
        <div class="welcome-card">
            <span class="welcome-icon">🚀</span>
            <h2>Welcome to your PM Command Center</h2>
            <p>Get started by adding your team members and projects.</p>
            <div class="welcome-actions">
                <a class="welcome-btn welcome-btn--primary" href="/team">👥 Add Team Members</a>
                <a class="welcome-btn" href="/projects">📁 Create First Project</a>
            </div>
        </div>
    </div>
}
else
{
    <!-- KPI Stats Bar -->
    <div class="ov-stats">
        <div class="ov-stat">
            <span class="ov-stat__num">@_projects.Count</span>
            <span class="ov-stat__label">Total Projects</span>
        </div>
        <div class="ov-stat ov-stat--green">
            <span class="ov-stat__num">@_projects.Count(p => p.Status == ProjectStatus.Active)</span>
            <span class="ov-stat__label">Active</span>
        </div>
        <div class="ov-stat ov-stat--amber">
            <span class="ov-stat__num">@_projects.Count(p => p.Status == ProjectStatus.AtRisk)</span>
            <span class="ov-stat__label">At Risk</span>
        </div>
        <div class="ov-stat ov-stat--red">
            <span class="ov-stat__num">@_projects.Count(p => p.Status == ProjectStatus.Delayed)</span>
            <span class="ov-stat__label">Delayed</span>
        </div>
        <div class="ov-stat ov-stat--purple">
            <span class="ov-stat__num">@_allOpenIssues</span>
            <span class="ov-stat__label">Open Issues</span>
        </div>
        <div class="ov-stat ov-stat--blue">
            <span class="ov-stat__num">@_teamMembers.Count</span>
            <span class="ov-stat__label">Team Size</span>
        </div>
        <div class="ov-stat">
            <span class="ov-stat__num">@(_dailyLog.DeepWork.Count + _dailyLog.TeamSync.Count + _dailyLog.Mentorship.Count + _dailyLog.AdHoc.Count)</span>
            <span class="ov-stat__label">Today's Log Items</span>
        </div>
    </div>

    <!-- Main grid: Project Health + Right panel -->
    <div class="ov-grid">
        <!-- ── Project Health Table ── -->
        <div class="ov-section ov-section--wide">
            <h2 class="ov-section__title">📋 Project Health</h2>
            @if (_projects.Count == 0)
            {
                <div class="cc-empty">No projects yet — <a href="/projects">create one</a></div>
            }
            else
            {
                <table class="health-table">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Progress</th>
                            <th>Team</th>
                            <th>🔴 Issues</th>
                            <th>⚠️ Delays</th>
                            <th>Target Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _projects)
                        {
                            var total  = p.WorkItems.Count;
                            var done   = p.WorkItems.Count(wi => wi.Status == WorkItemStatus.Completed);
                            var pct    = total == 0 ? 0 : (int)(done * 100.0 / total);
                            var issues = p.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Issue && wi.Status != WorkItemStatus.Completed);
                            var delays = p.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Delay && wi.Status != WorkItemStatus.Completed);
                            var overdue = p.TargetDate.HasValue && p.TargetDate.Value.Date < DateTime.UtcNow.Date && p.Status != ProjectStatus.Completed;
                            <tr class="health-row @(overdue ? "health-row--overdue" : "")">
                                <td class="health-name">@p.Name</td>
                                <td><span class="cc-badge @ProjectStatusBadge(p.Status)">@p.Status</span></td>
                                <td><span class="proj-priority-dot @PriorityDotClass(p.Priority)" title="@p.Priority"></span> @p.Priority</td>
                                <td class="health-progress">
                                    <div class="progress-bar">
                                        <div class="progress-bar__fill @ProgressClass(pct)" style="width:@pct%"></div>
                                    </div>
                                    <span class="progress-pct">@pct%</span>
                                </td>
                                <td class="health-team">
                                    @foreach (var pm in p.Members.Take(4))
                                    {
                                        <span class="avatar-sm avatar-color-@(pm.TeamMember?.AvatarColorIndex ?? 0)" title="@pm.TeamMember?.Name">
                                            @(pm.TeamMember?.Name?.Substring(0,1).ToUpper() ?? "?")
                                        </span>
                                    }
                                    @if (p.Members.Count > 4) { <span class="avatar-sm avatar-overflow">+@(p.Members.Count - 4)</span> }
                                </td>
                                <td class="health-issues @(issues > 0 ? "text-red" : "text-muted")">@issues</td>
                                <td class="health-delays @(delays > 0 ? "text-amber" : "text-muted")">@delays</td>
                                <td class="@(overdue ? "text-red" : "text-muted")">
                                    @(p.TargetDate.HasValue ? p.TargetDate.Value.ToString("MMM d, yyyy") : "—")
                                    @(overdue ? " ⚠️" : "")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- ── Right column ── -->
        <div class="ov-right">

            <!-- ── Daily Log Summary ── -->
            <div class="ov-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem">
                    <h2 class="ov-section__title" style="margin:0">📅 Today's Log <span class="ov-section__sub">@DateOnly.FromDateTime(DateTime.Today).ToString("MMM d")</span></h2>
                    <a href="/daily" style="font-size:0.75rem; color:var(--cc-blue); text-decoration:none">View Full →</a>
                </div>
                @{
                    var totalToday = _dailyLog.DeepWork.Count + _dailyLog.TeamSync.Count + _dailyLog.Mentorship.Count + _dailyLog.AdHoc.Count;
                    var doneToday  = _dailyLog.DeepWork.Count(x => x.Status == WorkItemStatus.Completed)
                                   + _dailyLog.TeamSync.Count(x => x.Status == WorkItemStatus.Completed)
                                   + _dailyLog.Mentorship.Count(x => x.Status == WorkItemStatus.Completed)
                                   + _dailyLog.AdHoc.Count(x => x.Status == WorkItemStatus.Completed);
                }
                @if (totalToday == 0)
                {
                    <div class="cc-empty">No tasks logged today. <a href="/daily">Add tasks →</a></div>
                }
                else
                {
                    <div class="daily-summary-grid">
                        <div class="daily-quad @(_dailyLog.DeepWork.Any() ? "" : "daily-quad--empty")">
                            <div class="daily-quad__header">🧠 Deep Work <span class="daily-quad__count">@_dailyLog.DeepWork.Count(x => x.Status == WorkItemStatus.Completed)/@_dailyLog.DeepWork.Count</span></div>
                            @foreach (var t in _dailyLog.DeepWork.Take(3))
                            {
                                <div class="daily-task-row @(t.Status == WorkItemStatus.Completed ? "daily-task--done" : "")">
                                    <span>@(t.Status == WorkItemStatus.Completed ? "✅" : "◯")</span>
                                    <span class="daily-task-title">@t.Title</span>
                                </div>
                            }
                            @if (_dailyLog.DeepWork.Count > 3) { <div class="daily-more">+@(_dailyLog.DeepWork.Count - 3) more</div> }
                        </div>

                        <div class="daily-quad @(_dailyLog.TeamSync.Any() ? "" : "daily-quad--empty")">
                            <div class="daily-quad__header">🤝 Team Sync <span class="daily-quad__count">@_dailyLog.TeamSync.Count(x => x.Status == WorkItemStatus.Completed)/@_dailyLog.TeamSync.Count</span></div>
                            @foreach (var t in _dailyLog.TeamSync.Take(3))
                            {
                                <div class="daily-task-row @(t.Status == WorkItemStatus.Completed ? "daily-task--done" : "")">
                                    <span>@(t.Status == WorkItemStatus.Completed ? "✅" : "◯")</span>
                                    <span class="daily-task-title">@t.TeammateName — @t.Title</span>
                                </div>
                            }
                            @if (_dailyLog.TeamSync.Count > 3) { <div class="daily-more">+@(_dailyLog.TeamSync.Count - 3) more</div> }
                        </div>

                        <div class="daily-quad @(_dailyLog.Mentorship.Any() ? "" : "daily-quad--empty")">
                            <div class="daily-quad__header">🎓 Mentorship <span class="daily-quad__count">@_dailyLog.Mentorship.Count(x => x.Status == WorkItemStatus.Completed)/@_dailyLog.Mentorship.Count</span></div>
                            @foreach (var t in _dailyLog.Mentorship.Take(3))
                            {
                                <div class="daily-task-row @(t.Status == WorkItemStatus.Completed ? "daily-task--done" : "")">
                                    <span>@(t.Status == WorkItemStatus.Completed ? "✅" : "◯")</span>
                                    <span class="daily-task-title">@t.Title</span>
                                </div>
                            }
                            @if (_dailyLog.Mentorship.Count > 3) { <div class="daily-more">+@(_dailyLog.Mentorship.Count - 3) more</div> }
                        </div>

                        <div class="daily-quad @(_dailyLog.AdHoc.Any() ? "" : "daily-quad--empty")">
                            <div class="daily-quad__header">⚡ Ad-Hoc <span class="daily-quad__count">@_dailyLog.AdHoc.Count(x => x.Status == WorkItemStatus.Completed)/@_dailyLog.AdHoc.Count</span></div>
                            @foreach (var t in _dailyLog.AdHoc.Take(3))
                            {
                                <div class="daily-task-row @(t.Status == WorkItemStatus.Completed ? "daily-task--done" : "")">
                                    <span>@(t.Status == WorkItemStatus.Completed ? "✅" : "◯")</span>
                                    <span class="daily-task-title">@t.Title</span>
                                </div>
                            }
                            @if (_dailyLog.AdHoc.Count > 3) { <div class="daily-more">+@(_dailyLog.AdHoc.Count - 3) more</div> }
                        </div>
                    </div>

                    <!-- Overall progress bar for the day -->
                    <div style="margin-top:0.75rem">
                        <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--cc-text-muted); margin-bottom:4px">
                            <span>Today's Progress</span>
                            <span>@doneToday / @totalToday completed</span>
                        </div>
                        <div class="progress-bar" style="height:6px">
                            <div class="progress-bar__fill @(doneToday == totalToday ? "fill--green" : "fill--blue")" style="width:@(totalToday == 0 ? 0 : (int)(doneToday * 100.0 / totalToday))%"></div>
                        </div>
                    </div>
                }
            </div>

            <!-- ── Multi-Scratchpads ── -->
            <div class="ov-section">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem">
                    <h2 class="ov-section__title" style="margin:0">📝 Scratchpads</h2>
                    <button class="btn-add" style="padding:3px 10px;font-size:0.75rem" @onclick="AddScratchpad">＋ New</button>
                </div>

                @if (_scratchpads.Count == 0)
                {
                    <div class="cc-empty">No scratchpads yet. Click <strong>＋ New</strong> to create one.</div>
                }
                else
                {
                    <!-- Tab row -->
                    <div class="scratch-tabs">
                        @foreach (var pad in _scratchpads)
                        {
                            <button class="scratch-tab @(_activePadId == pad.Id ? "scratch-tab--active" : "")"
                                    @onclick="() => _activePadId = pad.Id">
                                @pad.Title
                            </button>
                        }
                    </div>

                    @if (_activeScratchpad is not null)
                    {
                        <div class="scratch-body">
                            <div style="display:flex; gap:0.5rem; margin-bottom:0.5rem">
                                <input class="cc-input" style="flex:1; font-size:0.8rem; padding:4px 8px"
                                       value="@_activeScratchpad.Title"
                                       @onchange="@(e => RenamePad(_activeScratchpad, e.Value?.ToString() ?? "Untitled"))"
                                       placeholder="Pad title..." />
                                <button class="btn-delete" style="padding:3px 8px; font-size:0.75rem"
                                        @onclick="() => DeleteScratchpad(_activeScratchpad.Id)"
                                        title="Delete this pad">🗑</button>
                            </div>
                            <textarea class="cc-input"
                                      style="width:100%; height:140px; resize:vertical; font-size:0.85rem; line-height:1.5"
                                      value="@_activeScratchpad.Content"
                                      @onchange="@(e => SavePadContent(_activeScratchpad, e.Value?.ToString() ?? ""))"
                                      placeholder="Jot down thoughts, reminders, or notes..."></textarea>
                            <div style="font-size:0.65rem; color:var(--cc-text-muted); margin-top:3px; text-align:right">
                                Last updated: @_activeScratchpad.UpdatedDate.ToLocalTime().ToString("MMM d, HH:mm")
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Team Workload -->
            <div class="ov-section">
                <h2 class="ov-section__title">👥 Team Workload</h2>
                @if (_teamMembers.Count == 0)
                {
                    <div class="cc-empty">No team members — <a href="/team">add some</a></div>
                }
                else
                {
                    @foreach (var m in _teamMembers)
                    {
                        var openItems = m.AssignedWorkItems.Count(wi => wi.Status != WorkItemStatus.Completed && wi.Status != WorkItemStatus.RolledOver);
                        var maxItems = _maxWorkload == 0 ? 1 : _maxWorkload;
                        var barPct = Math.Min((int)(openItems * 100.0 / maxItems), 100);
                        <div class="workload-row">
                            <span class="avatar-sm avatar-color-@m.AvatarColorIndex">@m.Name.Substring(0,1).ToUpper()</span>
                            <div class="workload-info">
                                <div class="workload-header">
                                    <span class="workload-name">@m.Name</span>
                                    <span class="workload-role">@m.Role</span>
                                    <span class="workload-count @(openItems > 5 ? "text-red" : openItems > 2 ? "text-amber" : "text-muted")">
                                        @openItems items
                                    </span>
                                </div>
                                <div class="workload-bar">
                                    <div class="workload-bar__fill @(openItems > 5 ? "fill--red" : openItems > 2 ? "fill--amber" : "fill--green")"
                                         style="width:@barPct%"></div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Upcoming Deadlines -->
            <div class="ov-section">
                <h2 class="ov-section__title">📅 Upcoming Deadlines <span class="ov-section__sub">(next 14 days)</span></h2>
                @if (!_upcomingItems.Any())
                {
                    <div class="cc-empty">No deadlines in the next 14 days</div>
                }
                else
                {
                    @foreach (var (wi, proj) in _upcomingItems)
                    {
                        var daysLeft = (wi.DueDate!.Value.Date - DateTime.Today).Days;
                        var urgent = daysLeft <= 2;
                        <div class="deadline-row @(urgent ? "deadline-row--urgent" : "")">
                            <span class="deadline-icon">@ItemTypeIcon(wi.ItemType)</span>
                            <div class="deadline-info">
                                <span class="deadline-title">@wi.Title</span>
                                <span class="deadline-project">@proj.Name</span>
                            </div>
                            <span class="deadline-days @(urgent ? "text-red" : "text-amber")">
                                @(daysLeft == 0 ? "Today" : daysLeft == 1 ? "Tomorrow" : $"{daysLeft}d")
                            </span>
                        </div>
                    }
                }
            </div>

        </div><!-- end right -->
    </div><!-- end ov-grid -->
}

@code {
    private List<Project>    _projects    = [];
    private List<TeamMember> _teamMembers = [];
    private int _allOpenIssues;
    private int _maxWorkload;
    private List<(ProjectWorkItem wi, Project proj)> _upcomingItems = [];
    private DailyLogSummary _dailyLog = new([], [], [], []);

    // Scratchpads
    private List<Scratchpad> _scratchpads = [];
    private int _activePadId;
    private Scratchpad? _activeScratchpad => _scratchpads.FirstOrDefault(p => p.Id == _activePadId);

    protected override async Task OnInitializedAsync()
    {
        _projects    = (await Service.GetProjectsAsync()).ToList();
        _teamMembers = (await Service.GetTeamMembersAsync()).ToList();
        _dailyLog    = await Service.GetDailyLogSummaryAsync(DateOnly.FromDateTime(DateTime.Today));
        _scratchpads = (await Service.GetScratchpadsAsync()).ToList();
        if (_scratchpads.Any()) _activePadId = _scratchpads[0].Id;

        _allOpenIssues = _projects.Sum(p =>
            p.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Issue && wi.Status != WorkItemStatus.Completed));

        _maxWorkload = _teamMembers.Count == 0 ? 1 :
            _teamMembers.Max(m => m.AssignedWorkItems.Count(wi =>
                wi.Status != WorkItemStatus.Completed && wi.Status != WorkItemStatus.RolledOver));

        var cutoff = DateTime.UtcNow.AddDays(14);
        _upcomingItems = _projects
            .SelectMany(p => p.WorkItems
                .Where(wi => wi.DueDate.HasValue && wi.DueDate.Value <= cutoff && wi.DueDate.Value >= DateTime.UtcNow.Date
                             && wi.Status != WorkItemStatus.Completed)
                .Select(wi => (wi, p)))
            .OrderBy(x => x.wi.DueDate)
            .Take(10)
            .ToList();
    }

    // ── Scratchpad helpers ─────────────────────────────────────────────────
    private async Task AddScratchpad()
    {
        var pad = await Service.AddScratchpadAsync(new Scratchpad { Title = $"Pad {_scratchpads.Count + 1}" });
        _scratchpads.Add(pad);
        _activePadId = pad.Id;
    }

    private async Task SavePadContent(Scratchpad pad, string content)
    {
        pad.Content = content;
        await Service.UpdateScratchpadAsync(pad);
    }

    private async Task RenamePad(Scratchpad pad, string title)
    {
        pad.Title = string.IsNullOrWhiteSpace(title) ? "Untitled" : title;
        await Service.UpdateScratchpadAsync(pad);
    }

    private async Task DeleteScratchpad(int id)
    {
        await Service.DeleteScratchpadAsync(id);
        _scratchpads = (await Service.GetScratchpadsAsync()).ToList();
        _activePadId = _scratchpads.FirstOrDefault()?.Id ?? 0;
    }

    // ── CSV Export ─────────────────────────────────────────────────────────
    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Project Name,Status,Priority,Open Issues,Delays,Progress %,Target Date");
        foreach(var p in _projects)
        {
            var total = p.WorkItems.Count;
            var done = p.WorkItems.Count(wi => wi.Status == WorkItemStatus.Completed);
            var pct = total == 0 ? 0 : (int)(done * 100.0 / total);
            var issues = p.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Issue && wi.Status != WorkItemStatus.Completed);
            var delays = p.WorkItems.Count(wi => wi.ItemType == ProjectItemType.Delay && wi.Status != WorkItemStatus.Completed);
            var target = p.TargetDate?.ToString("yyyy-MM-dd") ?? "";
            sb.AppendLine($"{CsvValue(p.Name)},{CsvValue(p.Status.ToString())},{CsvValue(p.Priority.ToString())},{CsvValue(issues)},{CsvValue(delays)},{CsvValue($"{pct}%")},{CsvValue(target)}");
        }
        await JS.InvokeVoidAsync("downloadFile", $"PM_Report_{DateTime.Now:yyyyMMdd}.csv", sb.ToString());
    }

    // ── Display helpers ─────────────────────────────────────────────────────
    private static string ProjectStatusBadge(ProjectStatus s) => s switch
    {
        ProjectStatus.Active    => "badge--blue",
        ProjectStatus.AtRisk    => "badge--red",
        ProjectStatus.Delayed   => "badge--red",
        ProjectStatus.Completed => "badge--green",
        ProjectStatus.Planning  => "badge--yellow",
        _                       => "badge--grey"
    };

    private static string PriorityDotClass(ProjectPriority p) => p switch
    {
        ProjectPriority.Critical => "dot--red",
        ProjectPriority.High     => "dot--amber",
        ProjectPriority.Medium   => "dot--blue",
        _                        => "dot--grey"
    };

    private static string ProgressClass(int pct) => pct >= 80 ? "fill--green" : pct >= 40 ? "fill--blue" : "fill--amber";

    private static string ItemTypeIcon(ProjectItemType t) => t switch
    {
        ProjectItemType.Issue       => "🔴",
        ProjectItemType.Delay       => "⚠️",
        ProjectItemType.PendingItem => "🕐",
        ProjectItemType.Risk        => "⚡",
        ProjectItemType.Milestone   => "🎯",
        _                           => "📌"
    };

    private static string CsvValue(object? value)
    {
        var safe = value?.ToString() ?? string.Empty;
        if (safe.StartsWith("=") || safe.StartsWith("+") || safe.StartsWith("-") || safe.StartsWith("@") ||
            safe.StartsWith("\t") || safe.StartsWith("\r\n") || safe.StartsWith("\r") || safe.StartsWith("\n") || safe.StartsWith("|"))
            safe = $"'{safe}";
        var escaped = safe.Replace("\"", "\"\"");
        return "\"" + escaped + "\"";
    }
}
