## .NET / Blazor .gitignore

# Build outputs
bin/
obj/

# SQLite database (local only — never commit the DB file)
*.db
*.db-shm
*.db-wal

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Rider / JetBrains
.idea/

# VS Code
.vscode/

# OS files
Thumbs.db
.DS_Store

# NuGet
packages/
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/

# dotnet publish
**/publish/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Rider
.idea/

# Test results
TestResults/
